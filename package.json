{
  "name": "defrag",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:addon": "pnpm --filter @defrag/addon build",
    "watch:addon": "pnpm --filter @defrag/addon watch",
    "extract": "node packages/extract/src/cli.ts",
    "check": "pnpm -r check",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@laihoe/demoparser2"]
  }
}
